# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Defaults match the provided local paste paths.
TRANSCRIPTS_PATH=/tmp/vscode-paste/2026-10-25T14-15-28_86f275_transcripts.json
METADATA_PATH=/tmp/vscode-paste/2026-10-25T14-15-38_124e8d_data.json
PROCESSED_MEETINGS_PATH=data/processed/meetings.json
EMBEDDING_CACHE_PATH=data/processed/openai-embedding-cache.json

# Cost estimates only. Update when model pricing changes.
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
OPENAI_EMBEDDING_COST_PER_1M=0.02
